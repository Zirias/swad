# ============================================================================
# swad example configuration file
# for swad v%%VERSION%%
# ============================================================================

# Global service settings.
#
# The section header [global] can be left out, it's the default when starting
# to parse the configuration.
#
[global]

# Run as the following user.
#
# Can be a user name or a uid number, only works when starting as root.
# The default setting of -1 means don't attempt to switch to a different user.
#
# Hint: Don't use nobody, it has special meaning e.g. for NFS.
#
; user = -1

# Run as the following group.
#
# Can be a group name or a gid number, only works when starting as root.
# The default setting of -1 means use the primary group of the configured
# user, or don't attempt any change when user is also -1.
#
; group = -1

# Location of the pid file.
#
# Use a pidfile in this location when running as a daemon.
#
; pidfile = %%RUNSTATEDIR%%/swad.pid

# Logging verbosity.
#
# Set the maximum log level to use for logging output. This is overridden by
# the commandline flag `-v', which forces this setting to `debug'.
#
# Available levels:
#
# * fatal	Only log fatal errors leading to termination of the service
# * error	Also log non-fatal error conditions (indicating something is
# 		seriously wrong)
# * warning	Also log warnings (where something is likely to go wrong)
# * info	Also log relevant informational messages (like http request
# 		logging)
# * debug	Also log info probably only relevant for debugging swad
#
; log_level = info

# Resolve remote hosts
#
# Determines whether an attempt is made to resolve the hostname of a remote
# host.
#
; resolve_hosts = off

# Rate limit creation of new sessions
#
# Determines the maximum rates for creating new sessions allowed per remote
# host, can be given up to 8 times. Each value is of the form
# `<seconds>:<limit>`, meaning to allow at most <limit> new sessions to be
# created within <seconds> seconds. <seconds> must be in the range [1-86400],
# <limit> in the range [1-1024].
#
# The remote host for these limits is determined based on the
# `trusted_proxies` setting of the server.
#
# If not given, a default of 3 in 5 seconds, 5 per minute and 25 per hour is
# used.
#
; session_limit = 5:3
; session_limit = 60:5
; session_limit = 3600:25

# Rate limit login failures
#
# This is the default rate limit for failed logins. It follows the same syntax
# like the `session_limit` above and can be overridden per realm, see below.
#
# The limit is set per session and username, and when it is reached, no more
# logins are performed and an appropriate error message is displayed.
# It doesn't matter whether the username actually exists.
#
# If not given, a default of at most 5 failed logins in 15 minutes is used.
#
; login_fail_limit = 900:5

# Lifetime of a client session
#
# This configures when sessions expire. The value must have the format
# `<maxAge>[:<maxIdle>]` where <maxAge> is the maximum lifetime of a session
# in seconds, and <maxIdle> is the time in seconds after which an idle session
# (no client requests refering to it) expires.
#
# Authentication info is stored in the session, so an expired session will
# force a user to login again. Be aware a session is created for *every*
# unique client independent of authentication, so don't bump up the <maxIdle>
# value too high to avoid consuming lots of RAM for stale sessions.
#
# The default <maxAge> is 12 hours, the default <maxIdle> one hour. The
# minimum valid value for both is 60 (one minute).
#
; session_max_age = 43200:3600

# Where to expose the login endpoint
#
# This configures the base route for the login endpoint, including its
# resources (style and optionally javascript) found in the /static sub-route.
#
# If not given, it defaults to /login
# (so resources are found in /login/static)
#
; login_route = /login

# Where to find web resources
#
# This directory is searched for templates and the global stylesheets,
# overriding the builtin files if found. They are only read once at startup.
#
# Templates can be suffixed with .<realm>.html to only use them for the
# specific realm, so for example the file
#
#   login.SWAD.html
#
# would override the global login.html template for the default realm "SWAD".
#
# If not given, defaults to %%SYSCONFDIR%%/swad
#
; resource_dir = %%SYSCONFDIR%%/swad

# ============================================================================
# The following settings are still part of the global section, but configure
# the thread pool. Swad handles requests on worker threads from this thread
# pool. The thread pool will run with a fixed number of worker threads and
# offer a queue for waiting jobs for the case when no worker thread is
# currently idle.
#
# Only when the queue for waiting jobs is full, scheduling a thread job will
# fail and swad will return a "429 Too many requests" response.
#
# Don't tune up the number of threads too much though, the pool is not
# designed to scale to huge numbers of threads, e.g. searching for a thread
# is always done by iterating over all of them.

# How man worker threads to use per CPU/core
#
# This could be increased for heavy loads or for machines with few cores.
# When built for a system without POSIX user context switching, so a worker
# awaiting some "async task" blocks a worker thread, this defaults to 6
# threads per CPU/core.
#
# Min: 1, Max: 256, Default: 4
#
; threads_per_cpu = 1

# How many threads to use if we don't know the number of CPUs/cores
#
# If for some reason, the number of CPUs/cores of the system can't be
# determined, use this many worker threads.
# Min: 1, Max: 4096, Default: 16
#
; default_threads = 16

# Total maximum number of worker threads
#
# The thread pool will never create more than this number of threads.
# Min: 1, Max: 4096, Default: 256
#
; max_threads = 256

# How many queue slots to reserve per thread
#
# This configures the size of the queue for waiting jobs as a multiple of the
# available worker threads.
# Min: 1, Max: 64, Default: 2
#
; job_queue_per_thread = 16

# Total maximum size of the job queue
#
# The job queue will never be larger than this number.
# Min: 1, Max: 8192, Default: 512
#
; max_job_queue = 512

# ============================================================================

# Server(s).
#
# Each [server] section configures one HTTP server. To distinguish multiple
# servers, all but one must have an additional name given after a colon,
# for example [server:foo].
#
# Example:
#
# [server:tls]
# tls = on
# tls_cert_file = %%SYSCONFDIR%%/swad/swad.crt
# tls_key_file = %%SYSCONFDIR%%/swad/swad.key
# port = 8443
#
[server]

# The port number to listen on.
#
; port = 8080

# The host name or IP addresses to listen on.
#
# Can be given multiple times. If not given, the default behavior is to
# listen an all available interfaces.
#
; listen =

# The IP protocol version to use.
#
# Can be one of "any", "ipv4" or "ipv6".
#
; proto = any

# Whether to enable TLS for that server.
#
# If enabled, both tls_cert_file and tls_key_file must be given.
#
; tls = off

# File containing the server TLS certificate.
#
; tls_cert_file =

# File containing the private key for the TLS certificate.
#
; tls_key_file =

# Number of proxies to trust.
#
# This is used for determining the actual remote address. If left at 0,
# no proxies are trusted and the immediate remote address of the connection
# is used. Every trusted proxy is expected to write a valid "Forwarded"
# (RFC 7239) or "X-Forwarded-For" header.
#
# min: 0; max: 16
#
; trusted_proxies = 0

# Which header to trust from proxies.
#
# Control which header(s) to consider for getting remote address information
# from proxies. The following values are accepted:
#
#   xfwd		Only trust "X-Forwarded-For"
#   rfc			Only trust "Forwarded" (RFC 7239)
#   prefer_xfwd		Trust both, check "X-Forwarded-For" first
#   prefer_rfc		Trust both, check "Forwarded" first
#
# In general, you should at least prefer the header you know your reverse
# proxy writes. In any case, swad only uses information from one of these
# headers.
#
; trusted_header = prefer_xfwd

# NAT64 prefix.
#
# This is used to translate NAT64 addresses back to IPv4 addresses. The
# default is to use the well-known prefix.
#
; nat64_prefix = 64:ff9b::/96

# Connection timeout.
#
# Configures how long to wait for a request before closing the TCP connection
# to the client, in seconds. This also applies to "keep-alive" connections.
#
# min: 1, max: 3600
#
; connection_timeout = 10

# Request timeout.
#
# If a request pipeline on a thread job is running longer than this
# (in seconds), attempt to cancel the job and return an internal server
# error. Note times waiting for some async I/O task (which is used by the
# `exec` and `pam` credential checkers to talk to the respective child
# processes)  don't account for the request timeout.
#
# min: 1, max: 3600
#
; request_timeout = 15

# ============================================================================

# Credential checkers.
#
# In this section, named modules for checking user credentials can be
# configured, along with their arguments.
#
# The generic syntax is
#
#   <name> = <module>:<arg_1>[:<arg_2>[...:<arg_n>]]
#
# Available checkers:
#
# ,------------,-------------------------------------------------------------.
# | module     | description                                                 |
# >------------+-------------------------------------------------------------<
# | exec       | Authenticate by executing an external tool.                 |
# |            |                                                             |
# |            | This executes an external tool with the user name given as  |
# |            | its single argument and the password written to its         |
# |            | standard input. The tool must exit with an exit code of 0   |
# |            | to indicate a successful login, any non-zero exit code is   |
# |            | interpreted as login failure. If the tool writes something  |
# |            | to its standard output, this is interpreted as the user's   |
# |            | real name.                                                  |
# |            |                                                             |
# |            | Dummy example succeeding when the password equals the user  |
# |            | name:                                                       |
# |            |   #!/bin/sh                                                 |
# |            |   read pw                                                   |
# |            |   test "$pw" = "$1"                                         |
# |            |                                                             |
# |            | arg_1:   Full path to the tool to execute                   |
# |            | arg_2:   Execution timeout in ms (optional, default: 10000) |
# |            | arg_3:   Force-kill timeout in ms, if the tool ignores      |
# |            |          SIGTERM (optional, default: 5000)                  |
# >------------+-------------------------------------------------------------<
# | file       | Authenticate using a password file.                         |
# |            |                                                             |
# |            | This uses a password file that's partially compatible with  |
# |            | Apache's .htpasswd files. Only the "bcrypt" hashing is      |
# |            | supported. This means the hash must start with "$2y$" (like |
# |            | Apache's bcrypt hashes do), or "$2b$" or "$2a$". As an      |
# |            | extension to Apache's format, a user's real name may be     |
# |            | appended to a line after another colon, so entries in the   |
# |            | file are expected to have the following format:             |
# |            | <username>:$2{aby}$<cost>$<hash>[:<real name>]              |
# |            |                                                             |
# |            | The password file can be edited using the swadpw(1) tool.   |
# |            |                                                             |
# |            | arg_1:   Full path to the password file                     |
# >------------+-------------------------------------------------------------<
# | pam        | Authenticate with PAM.                                      |
# |            |                                                             |
# |            | This module uses a child process that keeps running as the  |
# |            | user initially starting swad. So it can authenticate with   |
# |            | PAM modules like pam_unix.so requiring superuser            |
# |            | privileges, if swad is started as root.                     |
# |            |                                                             |
# |            | arg_1:   The PAM service name (required)                    |
# >------------+-------------------------------------------------------------<
# | pow        | Require "proof of work" from the client.                    |
# |            |                                                             |
# |            | This module provides a guest login with a fixed user name   |
# |            | and password combination, but upon login also requires the  |
# |            | client browser to solve a cryptographic puzzle.             |
# |            |                                                             |
# |            | More details about it can be found in README.pow.md         |
# |            |                                                             |
# |            | arg_1:   Puzzle difficulty (optional, default: 4)           |
# |            | arg_2:   User name (optional, default: guest)               |
# |            | arg_3:   Password (optional, default: guest)                |
# `------------^-------------------------------------------------------------'
#
# Example:
#
# [checkers]
# snakeoil = exec:%%SYSCONFDIR%%/swad/check.sh:2000:2000
# passwd = file:%%SYSCONFDIR%%/swad/passwd
# pam_system = pam:system
# guest = pow:5
#
[checkers]
;

# ============================================================================

# Authentication realms.
#
# This section cotains realms for authentication. A realm is configured as a
# list of checkers which are allowed to successfully authenticate a user for
# the realm. The checkers are tried in the order they are given.
#
# The generic syntax is
#
#   <name> = <checker_1>[:checker_2>[...:<checker_n>]]
#
# A realm can be requested by the query parameter "realm" (like in
# "http://localhost:8080/login?realm=foo") or, for example by the reverse
# proxy, by setting the custom header "X-SWAD-Realm". If no specific realm is
# requested, swad uses a default realm named SWAD, so configure this one if
# you intend to use it.
#
# It's also possible to configure an individual rate limit for failed logins
# on a realm by adding up to 8 settings for `<name>_login_fail_limit`,
# overriding the default from `login_fail_limit`.
#
# Example:
#
# [realms]
# MySecretService = snakeoil:passwd:pam_system
# MySecretService_login_fail_limit = 1800:3
# MyPublicStuff = pow:pam_system
#
[realms]
; SWAD = dummy

